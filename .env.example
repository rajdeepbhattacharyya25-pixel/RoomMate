# Supabase Project Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
VITE_USE_LIVE_SUPABASE=true

# PostHog Product Analytics (Privacy-Preserving, Financial PII Scrubbed)
VITE_POSTHOG_KEY=phc_your_posthog_project_api_key
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_PROJECT_ID=your-posthog-project-id
VITE_POSTHOG_EMBED_DASHBOARD_URL=

# Firebase Web Configuration (Optional - for Web PWA push notifications)
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_VAPID_KEY=your-vapid-key

# Developer OTA Release Management (Kept locally on dev PC, never included in client bundle)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Direct PostgreSQL Connection (For Automated Backups / Admin CLI)
# SUPABASE_DB_URL=postgresql://postgres.pbzaaskftrmnvocczhat:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
# OR supply individual password:
# SUPABASE_DB_PASSWORD=your-database-password

# Supabase Edge Function Secrets (Set via: supabase secrets set KEY=VALUE)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# UptimeRobot MCP / API Configuration (Free Tier Monitoring)
UPTIMEROBOT_API_KEY=your-uptimerobot-main-or-readonly-api-key

# Inbound Webhook Receiver Secret (For Email-to-Webhook & External Relays)
UPTIME_WEBHOOK_SECRET=your-random-webhook-secret-here

# ImgBB Image Hosting — Profile photos & UPI QR codes are uploaded here;
# only the CDN URL is stored in Supabase (never raw base64). Get key at https://api.imgbb.com
VITE_IMGBB_API_KEY=your-imgbb-api-key
